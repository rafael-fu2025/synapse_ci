#-------------------------
# Operating Specific Junk Files
#-------------------------

# OS X
.DS_Store
.AppleDouble
.LSOverride

# OS X Thumbnails
._*

# Windows image file caches
Thumbs.db
ehthumbs.db
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Linux
*~

# KDE directory preferences
.directory

# Linux trash folder which might appear on any partition or disk
.Trash-*

#-------------------------
# Environment Files
#-------------------------
# These should never be under version control,
# as it poses a security risk.
.env
.env.*
!.env.example
.vagrant
Vagrantfile

#-------------------------
# Temporary Files
#-------------------------
# writable/ is local scratch space: black-box run artefacts, captured pages,
# isolated browser profiles, and one-off diagnostic scripts. None of it is
# committed - the audit reports under papers/blackbox/results/ describe these
# paths as "local, not committed".
# The development scripts the team keeps under writable/ stay visible through
# the negations below. Add a new negation line here when a new script family
# is introduced under writable/, otherwise `git add writable/` will skip it.
/writable/*
!/writable/.htaccess
!/writable/index.html
!/writable/cache/
!/writable/debugbar/
!/writable/logs/
!/writable/session/
!/writable/uploads/
!/writable/*-development-*.php
!/writable/*-development-*.py

# These development scripts do not own any DDL: each one preflights, backs up,
# and then runs the already-versioned migrations under app/Database/Migrations/,
# capturing evidence. The migrations own the schema, so the scripts are no longer
# added to source control (they stay on the local working copy for attended
# deployments). `php spark migrate --all` is the supported path.
/writable/ai-development-migrate.php
/writable/audience-development-migrate.php
/writable/bmg-development-migrate.php
/writable/chat-development-migrate.php
/writable/engagement-development-migrate.php
/writable/notification-development-migrate.php
/writable/referral-development-migrate.php
/writable/staff-assignment-development-migrate.php
/writable/teams-development-migrate.php
/writable/workflow-development-migrate.php
!/writable/*-validation*.php
!/writable/*-validation*.py
!/writable/directory-import-*
!/writable/isolated-inventory-*
!/writable/ai-analysis-scope-upgrade.php
!/writable/bmg-permissions-offline-test.php

/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

# Runtime carousel uploads; retain the repository placeholder.
/public/uploads/carousel/*
!/public/uploads/carousel/.gitkeep

# PHPUnit output (cache and reports).
/writable/build/

# Private backups, runtime data and generated local validation artifacts.
/writable/backups/
# UI AI provider credentials, storage-key envelope, and runtime dispatch control are private.
/writable/ai-settings/
/writable/ai-dispatch-control.json
/writable/report-temp/
/writable/widget-test-tools/
/writable/*.log
/writable/isolated-inventory-db/
/writable/queue-isolated-*/
/writable/__pycache__/
/writable/audit-upgrade-*/
# Screenshot/preview output from local design and contrast checks.
/writable/*-preview/
/writable/*-previews/

# Local audit explorer responsive-render checks.
/writable/audit-responsive-artifacts/
/writable/audit-responsive-render.php
/writable/audit-responsive.cjs

# One-off local module development and workflow scripts.
/writable/install-workflow-notifications-task.py
/writable/verify-windowless-workflow.py
/writable/teams-development-migrate.php
/writable/workflow-development-migrate.php
/writable/workflow-development-status.php
/writable/workflow-notifications-run.php
/writable/workflow-notifications-task.xml
/writable/chat-development-migrate.php
/writable/chat-development-smoke.php
# Uploaded member photos are personal data, not source.
/writable/profile-photos/*
!/writable/profile-photos/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

# Approved USB firmware binaries remain private deployment artifacts.
/writable/firmware/

/writable/debugbar/*
!/writable/debugbar/index.html

php_errors.log

#-------------------------
# User Guide Temp Files
#-------------------------
/user_guide_src/build/*
/user_guide_src/cilexer/build/*
/user_guide_src/cilexer/dist/*
/user_guide_src/cilexer/pycilexer.egg-info/*

#-------------------------
# Test Files
#-------------------------
/tests/coverage*
/tests/browser/.bak.cjs

# Generated Python bytecode.
__pycache__/
*.pyc

# Don't save phpunit under version control.
/phpunit

#-------------------------
# Local-Only Directories
#-------------------------
# Development documentation, the test suites and research papers stay on the
# local working copy. Files already tracked in these directories keep their
# history and remain tracked; these rules only stop new files from being
# added to them. The Team Workspace tracker is the one versioned execution log.
/docs/*
!/docs/MOBILE_TEAM_WORKSPACE_IMPLEMENTATION.md
/tests/
# AI CI fixtures must be available to clean checkouts; keep unrelated local tests ignored.
!/tests/
/tests/*
!/tests/unit/
/tests/unit/*
!/tests/unit/MisPeopleSyncTest.php
!/tests/unit/AiEnabledTestConfirmationTest.php
!/tests/unit/AiPipelineProvenanceTest.php
!/tests/unit/AiRecoveryAttemptsTest.php
!/tests/unit/AiRecoveryMariaDbTest.php
!/tests/unit/TeamWorkspaceConfigTest.php
!/tests/unit/TeamWorkspaceInvalidationTest.php
!/tests/unit/NotificationTargetTest.php
!/tests/unit/PushPublisherTest.php
!/tests/unit/TeamPushRecipientTest.php
!/tests/unit/PushInstallationCapabilityTest.php
!/tests/unit/RequestContextFilterTest.php
!/tests/unit/ApiTokenConcurrencyTest.php
!/tests/_support/
/tests/_support/*
!/tests/_support/api-token-race-worker.php
!/tests/database/
/tests/database/*
!/tests/database/TeamAccessTest.php
!/tests/database/MobileTokenUserReferenceMigrationTest.php
!/tests/feature/
/tests/feature/*
!/tests/feature/TeamApiHttpTest.php
!/tests/browser/
/tests/browser/*
!/tests/browser/package.json
!/tests/browser/package-lock.json
/papers/

