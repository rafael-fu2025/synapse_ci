#--------------------------------------------------------------------
# Example environment configuration
#
# Copy this file and uncomment the settings you need:
#   cp .env.example .env
#
# CodeIgniter also falls back to `env` when `.env` is absent; that file
# carries the full stock CI4 reference. This file lists only settings
# this application actually reads.
#
# Never commit `.env`. It holds real secrets.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = 'https://your-host.example'
# Set this when running behind a reverse proxy; see docs/WEB_SECURITY.md.
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = true
# The strict script/style policy is report-only; low-risk CSP is
# enforced separately. See docs/WEB_SECURITY.md.

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = ''
# database.default.username = ''
# database.default.password = ''
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# Test database. Defaults live in app/Config/Database.php (MySQLi,
# humus_db_test on 127.0.0.1). Override here if local credentials differ.
# database.tests.hostname = 127.0.0.1
# database.tests.database = humus_db_test
# database.tests.username = root
# database.tests.password = ''
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_unicode_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Framework-level key used by CodeIgniter's Encryption service.
# encryption.key =

# Counseling notes: required, no fallback. Each key must be exactly
# 64 hexadecimal characters (32 bytes).
# COUNSELLING_KEY_VERSION must be a positive integer. Version 1 reads
# COUNSELLING_KEY; version n > 1 reads COUNSELLING_KEY_Vn, never the
# version-1 key. Retain every key that historical notes still need.
# Generate only for a fresh install with no encrypted notes:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Missing or malformed keys must fail closed; see README.
#
# COUNSELLING_KEY = ''
# COUNSELLING_KEY_VERSION = 1
# COUNSELLING_KEY_V2 = ''

# Identified survey answers: required, no fallback. Exactly 64
# hexadecimal characters. Rotation follows the same versioning rule,
# and old keys must be retained for historical responses.
# SURVEY_KEY = ''
# SURVEY_KEY_VERSION = 1
# SURVEY_KEY_V2 = ''

#--------------------------------------------------------------------
# SESSION / LOGGER
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null
# logger.threshold = 4

#--------------------------------------------------------------------
# MIS AUTHENTICATION (server-side only; never expose to public assets)
#--------------------------------------------------------------------

# FUMIS_ENABLED = false
# FUMIS_BASE_URL = 'https://mis.foundationu.com/sandbox'
# FUMIS_API_KEY = ''
# FUMIS_TIMEOUT_SECONDS = 10
# Fixtures only. Ignored unless ENVIRONMENT is development or testing.
# FUMIS_FAKE_ENABLED = false

#--------------------------------------------------------------------
# BMG ROTATION — leave disabled until firmware and physical safety
# acceptance. Server gating is not an emergency stop and cannot stop
# offline cached schedules. See docs/BMG_USB.md.
#--------------------------------------------------------------------

# BMG_HARDWARE_ENABLED = false
# BMG_USB_FLASH_ENABLED = false

#--------------------------------------------------------------------
# TENANCY
#--------------------------------------------------------------------

# Active tenant for CLI workers, cron and sandbox runs. Web requests
# take the tenant from the session. Defaults to 1 (Foundation
# University) when unset.
# SYNAPSE_TENANT_ID = 1

#--------------------------------------------------------------------
# OPTIONAL SECURITY TUNING (defaults shown; see docs/WEB_SECURITY.md)
#--------------------------------------------------------------------

# contentsecuritypolicy.reportOnly = true
# loginsecurity.ipAttempts = 60
# loginsecurity.ipWindowSeconds = 60
# loginsecurity.identityAttempts = 5
# loginsecurity.identityWindowSeconds = 300
