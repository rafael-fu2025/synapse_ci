{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synapse.invalid/schemas/blackbox/results.schema.json",
  "title": "SYNAPSE black-box sanitized results",
  "description": "Per-case observations tied to one hash-verified run root. Hash consistency is integrity metadata, not independent proof that execution occurred or that the tester is trusted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "sanitized",
    "suite_target_commit",
    "run_manifest",
    "run_manifest_sha256",
    "cases"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "sanitized": {
      "type": "boolean",
      "const": true
    },
    "suite_target_commit": {
      "$ref": "#/$defs/commit"
    },
    "run_manifest": {
      "$ref": "#/$defs/relativePath"
    },
    "run_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 245,
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z][A-Z0-9]*)*-\\d{3}$"
    },
    "plainText": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\r\\n]*$"
    },
    "nonemptyPlainText": {
      "allOf": [
        {
          "$ref": "#/$defs/plainText"
        },
        {
          "minLength": 1
        }
      ]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![./])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[:\\\\\\u0000-\\u001f\\u007f])[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "coverageTarget": {
      "type": "string",
      "pattern": "^(?:step:[1-9][0-9]*|assertion:(?:expected|negative|cleanup)|blocker|scope:not-in-run)$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "sha256",
        "description",
        "covers"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/$defs/nonemptyPlainText"
            },
            {
              "maxLength": 1024
            }
          ]
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coverageTarget"
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "actions",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "COMPLETED",
            "NOT_REQUIRED",
            "FAILED",
            "PENDING"
          ]
        },
        "actions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/nonemptyPlainText"
              },
              {
                "maxLength": 512
              }
            ]
          }
        },
        "notes": {
          "allOf": [
            {
              "$ref": "#/$defs/plainText"
            },
            {
              "maxLength": 2048
            }
          ]
        }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "verdict",
        "actual",
        "evidence",
        "cleanup"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/caseId"
        },
        "verdict": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL",
            "BLOCKED",
            "NOT_IN_RUN"
          ]
        },
        "actual": {
          "allOf": [
            {
              "$ref": "#/$defs/plainText"
            },
            {
              "maxLength": 4096
            }
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "cleanup": {
          "$ref": "#/$defs/cleanup"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "NOT_RUN"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "actual": {
                "maxLength": 0
              },
              "evidence": {
                "maxItems": 0
              },
              "cleanup": {
                "properties": {
                  "status": {
                    "enum": [
                      "NOT_REQUIRED",
                      "PENDING"
                    ]
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "actual": {
                "minLength": 1
              },
              "evidence": {
                "minItems": 1
              },
              "cleanup": {
                "properties": {
                  "status": {
                    "enum": [
                      "COMPLETED",
                      "NOT_REQUIRED"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
