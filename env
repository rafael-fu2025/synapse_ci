#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = true
# The strict script/style policy is report-only; low-risk CSP is enforced separately.
# contentsecuritypolicy.reportOnly = true
# Login attempts share atomic database budgets across portals/workers.
# Defaults: 60/IP/minute, 5/normalized-identifier+IP per 5 minutes.
# Values must remain positive; zero/malformed configuration fails closed.
# loginsecurity.ipAttempts = 60
# loginsecurity.ipWindowSeconds = 60
# loginsecurity.identityAttempts = 5
# loginsecurity.identityWindowSeconds = 300
# Configure App.proxyIPs only for the exact reverse proxies you control.
# Never trust arbitrary X-Forwarded-For headers. See docs/WEB_SECURITY.md.

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = ci4
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

# Counseling notes: required private key configuration (no fallback).
# Each key must be exactly 64 hexadecimal characters (32 bytes).
# COUNSELLING_KEY_VERSION must be a positive integer: 1 uses COUNSELLING_KEY;
# n > 1 uses explicitly configured COUNSELLING_KEY_Vn, never the version-1 key.
# Missing/malformed keys or versions must fail closed; see README deployment contract.
# Before upgrading existing fallback-encrypted notes, securely preserve the old
# actual encryption key as COUNSELLING_KEY. Do not blindly generate a replacement.
# Generate a key only for a fresh installation with no existing encrypted notes:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Never commit keys. Retain every key required to decrypt historical notes.
# COUNSELLING_KEY = ''
# COUNSELLING_KEY_VERSION = 1
# COUNSELLING_KEY_V2 = ''

# Identified survey answers use a dedicated AES-256-GCM key (no fallback).
# Set SURVEY_KEY to 64 random hexadecimal characters through private configuration.
# Generate locally: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Never commit keys. Retain old keys when rotating to SURVEY_KEY_VERSION = 2,
# SURVEY_KEY_V2 = <new 64-character hex key>; historical responses need old keys.
# SURVEY_KEY = ''
# SURVEY_KEY_VERSION = 1

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# AI INSIGHTS — configure easily in Administration > AI Settings
# UI saves an encrypted profile: Save settings > Test connection > Enable aggregate AI.
# Select approved departments and grant tenant/department/role AI access separately.
# Source permissions still apply; no manual key/revision setup is needed.
# UI queueing/enabling does not start a worker; schedule ai:dispatch separately.
# The commented settings below are optional deployment defaults (UI overrides them).
# Custom OpenAI-compatible API bases preserve their complete path prefix.
# No patient-level records or notes may be sent. See docs/AI_OPERATIONS.md.
#--------------------------------------------------------------------
# ai.enabled = false
# ai.profileId = 'clinic-reviewed'
# ai.adapter = 'openai_chat_completions'
# ai.baseUrl = 'https://ai-gateway.example.org/team-a/v1'
# ai.allowedOrigins = 'https://ai-gateway.example.org'
# ai.model = 'approved-model-id'
# ai.reasoningEffort = ''
# Empty leaves provider default; 'disabled' or 'enabled' sends an explicit thinking type.
# MiniMax-M3 endpoints requiring thinking off need 'disabled', not reasoningEffort 'none'.
# ai.thinkingMode = ''
# ai.maxInputTokens = 8192
# ai.authMode = 'bearer'
# ai.apiKey = ''
# ai.apiKeyHeader = 'X-API-Key'
# ai.apiKeyHeaderAllowlist = 'X-API-Key,API-Key'
# ai.credentialVersion = '1'
# ai.maxOutputTokensField = 'max_tokens'
# ai.structuredOutputMode = 'none'
# Trusted absolute PHP CLI path for bounded DNS; empty uses PHP_BINDIR/php(.exe).
# ai.resolverPhpBinary = ''
# ai.connectTimeoutSeconds = 5
# ai.requestTimeoutSeconds = 45
# ai.maxRequestBytes = 65536
# ai.maxResponseBytes = 262144
# ai.maxOutputTokens = 2000
# Current worker supports one request at a time and one attempt; never blind retry.
# ai.maxConcurrentRequests = 1
# ai.maxAttempts = 1
# ai.maxJobsPerRun = 5
# ai.dailyRequestLimit = 50
# ai.minimumContributors = 10
# ai.retentionDays = 30
# ai.encryptionKey = ''
# ai.governanceApproved = false
# ai.programLibraryApproved = false
# ai.capabilityRevision = 'department-programs-v2:prompt-v2'
# ai.approvedTenants = ''
# Reviewed subset of clinic,guidance,bmg; this alone grants no access or activation.
# ai.approvedUnits = 'clinic'
# ai.approvedRevision = ''
# ai.compatibilityApprovedRevision = ''
# Exact private-network exception origins must ALSO be in allowedOrigins.
# HTTPS is preferred for self-hosted endpoints; never disable certificate validation.
# ai.privateOrigins = ''
# ai.caBundle = ''
# Plain HTTP is disabled; allowLocalHttp alone permits synthetic testing only.
# ai.allowLocalHttp = false
# ai.allowPrivateHttpDispatch = false

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# MIS AUTHENTICATION (server-side only; no secrets in public assets)
#--------------------------------------------------------------------
# FUMIS_ENABLED = false
# FUMIS_BASE_URL = 'https://mis.foundationu.com/sandbox'
# FUMIS_API_KEY = ''
# FUMIS_TIMEOUT_SECONDS = 10
# Explicit development/testing fixtures only. Never enable for real users.
# FUMIS_FAKE_ENABLED = false

#--------------------------------------------------------------------
# REALTIME — optional Workerman process; existing polling remains enabled
#--------------------------------------------------------------------
# Generate TWO independent secrets; run this command once for each key:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Keep keys private and shared only by the app and realtime process.
# realtime.enabled = false
# realtime.signingKey = ''
# realtime.publishKey = ''
# Exact browser origins, comma-separated, with no trailing slash (no wildcards).
# realtime.allowedOrigins = 'http://localhost:8080'
# realtime.listen = 'websocket://127.0.0.1:8081'
# Never expose or reverse-proxy the HTTP publisher outside loopback.
# realtime.publishListen = 'http://127.0.0.1:8082'
# Use wss://your-host/realtime behind a TLS reverse proxy in production.
# realtime.publicUrl = 'ws://127.0.0.1:8081'
# realtime.ticketTtl = 60
# realtime.maxConnections = 512
# realtime.maxPublishConnections = 32
# Start separately: php spark realtime:serve start
# Deployment, security limits, and future BMG RPM integration: docs/REALTIME.md

#--------------------------------------------------------------------
# BMG ROTATION — leave disabled until firmware and physical safety acceptance
#--------------------------------------------------------------------
# Server gating is not an emergency stop and cannot stop offline cached schedules.
# An explicit facilities.hardware.manage DB grant is also required; no default grant.
# BMG_HARDWARE_ENABLED = false
# USB firmware installation is separately gated; identification/monitoring need no flash gate.
# Requires explicit hardware permission, maintenance, disabled schedule, bound device,
# physical motor isolation, and an administrator-approved private firmware catalog.
# Keep BMG_HARDWARE_ENABLED=false during USB installation.
# BMG_USB_FLASH_ENABLED = false
# Optional trusted-template compiler (separate from USB-flash and motor gates).
# Use a private, absolute Arduino CLI executable path. Install ESP32 core 3.3.3
# and ArduinoJson 7.4.2 on the server first. See docs/BMG_USB.md.
# bmgbuild.enabled = false
# bmgbuild.cli = ''
# Generate an independent secret locally; never commit it:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# bmgbuild.signingKey = ''
# bmgbuild.timeoutSeconds = 180
