<resources>

    <style name="SystemNavigationBarTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Android 7 has light-only system buttons. -->
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="SystemNavigationBarTheme">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Keep themed field backgrounds visible when a password manager fills them. -->
        <item name="android:autofilledHighlight">@android:color/transparent</item>
    </style>

</resources>
